{
  "name": "claude-glm-auto",
  "version": "1.0.0",
  "description": "Auto-continue for Claude Code on GLM (bigmodel.cn): watches the 5-hour token window via the GLM quota API, shows it in the title bar, and resumes when the limit resets",
  "keywords": ["glm", "claude-code", "bigmodel", "zhipu", "auto-resume", "auto-continue", "quota"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Radar-Lei/claude-auto.git"
  },
  "bugs": {
    "url": "https://github.com/Radar-Lei/claude-auto/issues"
  },
  "homepage": "https://github.com/Radar-Lei/claude-auto#readme",
  "type": "module",
  "bin": {
    "claude-glm-auto": "dist/claude-glm-auto.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "os": ["win32", "darwin", "linux"],
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^26.0.0",
    "tsx": "^4.22.4",
    "typescript": "^5"
  },
  "dependencies": {
    "@xterm/headless": "^6.0.0",
    "node-pty": "^1.1.0"
  },
  "scripts": {
    "claude": "bunx tsx claude-glm-auto.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc --project tsconfig.build.json"
  }
}
